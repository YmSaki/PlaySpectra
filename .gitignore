# Build trees & artifacts
node_modules/
mcp/dist/
/build/
# Anchored: a bare "playspectra" pattern would match at every level and hide the
# Go package directory. Only the root binary a bare `go build ./cmd/playspectra`
# drops on Windows is ignored; the canonical output goes to build/.
/playspectra.exe
layer/build/
# clangd-only configure tree (compile_commands.json source, see layer/.clangd). Generated.
layer/build-clangd/
layer/manifest/*.dll
layer/manifest/*.so
__pycache__/
*.log
*.pdb
*.obj
*.ilk

# SteamVR driver (driver/) & built app binaries -- generated, not source.
# Tracked source: driver/src/, driver/CMakeLists.txt, driver/playspectra/driver.vrdrivermanifest
driver/build/
# clangd-only configure tree (compile_commands.json source, see driver/.clangd). Generated.
driver/build-clangd/
bin/

# Local venvs (e.g. .venv-mcp for run_mcp_verify_monado.sh; mcp must be isolated, not in a shared env)
.venv*/

# Large external dependencies (fetched/extracted by setup; reproduced, not source)
third_party/

# .claude is local process state by default. Published exceptions only: gate rules
# and shared settings. Official specs live in docs/.
# Order matters: un-ignore the dir itself, ignore its children, then re-include.
!.claude/
.claude/*
!.claude/rules/
!.claude/settings.json

# Dev memos & work reports (local only, not shipped)
feature-inventory.csv
refactor-plan.csv
refactor-plan-review.md
/reports/
