{
  "name": "controller_ops",
  "description": "Exercises the expanded operate surface: move_controller (grip+aim pose) and set_input (arbitrary input path), self-checked via assert. hello_xr renders controllers as cubes, so move_controller also moves what a capture would show.",
  "steps": [
    {"cmd": "hello", "role": "writer"},
    {"cmd": "assert", "name": "baseline right grip x=0.2", "get": ["right", "grip", "position", 0], "op": "near", "value": 0.2, "tol": 0.01},
    {"cmd": "move_controller", "hand": "right", "to": {"position": [0.7, 1.1, -0.3]}, "duration_ms": 300},
    {"cmd": "assert", "name": "right grip -> x=0.7", "get": ["right", "grip", "position", 0], "op": "near", "value": 0.7, "tol": 0.02},
    {"cmd": "assert", "name": "right grip -> y=1.1", "get": ["right", "grip", "position", 1], "op": "near", "value": 1.1, "tol": 0.02},
    {"cmd": "assert", "name": "right aim also moved -> x=0.7", "get": ["right", "aim", "position", 0], "op": "near", "value": 0.7, "tol": 0.02},
    {"cmd": "set_input", "hand": "left", "path": "/input/squeeze/value", "value": 0.9},
    {"cmd": "assert", "name": "left squeeze -> 0.9", "get": ["left", "inputs", "/input/squeeze/value"], "op": "near", "value": 0.9, "tol": 0.02},
    {"cmd": "set_input", "hand": "left", "path": "/button/x/touch", "value": true},
    {"cmd": "assert", "name": "left x/touch -> true", "get": ["left", "inputs", "/button/x/touch"], "op": "true"},
    {"cmd": "reset"},
    {"cmd": "assert", "name": "reset -> right grip x=0.2", "get": ["right", "grip", "position", 0], "op": "near", "value": 0.2, "tol": 0.01}
  ]
}
