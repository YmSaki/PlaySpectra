{
  "name": "operate_completeness",
  "description": "Completeness of the operate surface (CLAUDE.md north star: every action type, BOTH hands). controller_ops covers move_controller(right)+set_input(left); this covers the mirror hands plus set_trigger(both) and strafe -- the paths not exercised elsewhere. All self-checked via assert against get_state (app-independent, :52702 only). strafe/walk_forward release the stick to neutral, so we assert the release; their locomotion effect is app-side (see run_scenario_e2e_monado.sh).",
  "steps": [
    {"cmd": "hello", "role": "writer"},
    {"cmd": "trigger", "hand": "right", "value": 0.8, "duration_ms": 150},
    {"cmd": "assert", "name": "right trigger -> 0.8", "get": ["right", "inputs", "/input/trigger/value"], "op": "near", "value": 0.8, "tol": 0.02},
    {"cmd": "trigger", "hand": "left", "value": 0.6, "duration_ms": 150},
    {"cmd": "assert", "name": "left trigger -> 0.6 (both hands)", "get": ["left", "inputs", "/input/trigger/value"], "op": "near", "value": 0.6, "tol": 0.02},
    {"cmd": "move_controller", "hand": "left", "to": {"position": [-0.7, 1.0, -0.4]}, "duration_ms": 250},
    {"cmd": "assert", "name": "left grip -> x=-0.7 (mirror of controller_ops)", "get": ["left", "grip", "position", 0], "op": "near", "value": -0.7, "tol": 0.02},
    {"cmd": "assert", "name": "left aim also moved -> x=-0.7", "get": ["left", "aim", "position", 0], "op": "near", "value": -0.7, "tol": 0.02},
    {"cmd": "set_input", "hand": "right", "path": "/input/thumbstick/y", "value": 0.5},
    {"cmd": "assert", "name": "right thumbstick.y -> 0.5 (mirror of controller_ops)", "get": ["right", "inputs", "/input/thumbstick/y"], "op": "near", "value": 0.5, "tol": 0.02},
    {"cmd": "strafe", "hand": "left", "speed": 0.9, "duration_ms": 200},
    {"cmd": "assert", "name": "strafe dispatched then released stick to neutral", "get": ["left", "inputs", "/input/thumbstick/x"], "op": "near", "value": 0.0, "tol": 0.02},
    {"cmd": "reset"},
    {"cmd": "assert", "name": "reset -> left trigger back to 0", "get": ["left", "inputs", "/input/trigger/value"], "op": "near", "value": 0.0, "tol": 0.01}
  ]
}
